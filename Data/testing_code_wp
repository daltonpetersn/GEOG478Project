<!DOCTYPE html>
<html>
  <head>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
      #mapid {
          height: 600px;
          width: 800px;
      }
      .info {
          padding: 6px 8px;
          font: 14px/16px Arial, Helvetica, sans-serif;
          background: white;
          background: rgba(255,255,255,0.8);
          box-shadow: 0 0 15px rgba(0,0,0,0.2);
          border-radius: 5px;
      }
      .legend {
          line-height: 18px;
          color: #555;
      }
      .legend i {
          width: 18px;
          height: 18px;
          float: left;
          margin-right: 8px;
          opacity: 0.7;
      }
    </style>
    <title>WEBGIS Project</title>
  </head>
  <body>
    <div id="mapid"></div>
    <script>
        var map = L.map('mapid').setView([37.8, -96], 4);

        var tiles = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        // Load GeoJSON from a local file
        fetch('./json/US_Json_IRG.json') // Use a relative path to the GeoJSON file
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok ' + response.statusText);
                }
                return response.json();
            })
            .then(data => {
                // Add GeoJSON to the map with onEachFeature
                L.geoJson(data, {
                    onEachFeature: function (feature, layer) {
                        // Bind a popup to each feature
                        layer.on('click', function () {
                            if (feature.properties && feature.properties.name) {
                                layer.bindPopup('State: ' + feature.properties.name).openPopup();
                            } else {
                                layer.bindPopup('State name not available').openPopup();
                            }
                        });
                    }
                }).addTo(map);
            })
            .catch(error => console.error('Error loading GeoJSON:', error));

        // Add a legend
        var legend = L.control({ position: 'bottomright' });

        legend.onAdd = function (map) {
            var div = L.DomUtil.create('div', 'info legend');
            var categories = ['Category 1', 'Category 2', 'Category 3', 'Category 4', 'Category 5'];
            var colors = ['#FFEDA0', '#FED976', '#FEB24C', '#FD8D3C', '#FC4E2A'];

            // Loop through categories and generate a label with a colored square for each
            for (var i = 0; i < categories.length; i++) {
                div.innerHTML +=
                    '<i style="background:' + colors[i] + '"></i> ' +
                    categories[i] + '<br>';
            }
            return div;
        };

        legend.addTo(map);
    </script>
  </body>
</html>
